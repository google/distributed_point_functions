    module_name = "riegeli",
    integrity = "sha256-DajoxHTXNvfBjnLJvX7hjJB6h4WNVD0sYROcaAC81hc=",
    strip_prefix = "riegeli-4604c50c33b486bd7bd19abe2212175dca3a8c24",
